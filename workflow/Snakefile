        jpt_thousand_ld_decay=f"{folder_pattern}/data_process/ld_decay/jpt_thousand_ld_decay_{final_ts_pattern}.stat.gz",
        yri_sim_ld_decay=f"{folder_pattern}/data_process/ld_decay/yri_sim_ld_decay_{final_ts_pattern}.stat.gz",
        ceu_sim_ld_decay=f"{folder_pattern}/data_process/ld_decay/ceu_sim_ld_decay_{final_ts_pattern}.stat.gz",
        chb_sim_ld_decay=f"{folder_pattern}/data_process/ld_decay/chb_sim_ld_decay_{final_ts_pattern}.stat.gz",
        jpt_sim_ld_decay=f"{folder_pattern}/data_process/ld_decay/jpt_sim_ld_decay_{final_ts_pattern}.stat.gz",
    output:
        plot=f"{folder_pattern}/data_process/ld_decay/ld_decay_plot_{final_ts_pattern}.pdf",
    log:
        f"logs/{folder_pattern}/plot_maf_{final_ts_pattern}.log",
    conda:
        "envs/plot.yaml"
    params:
        arm=lambda wildcards: wildcards.arm,
        chromosome=lambda wildcards: wildcards.chromosome,
    script:
        "scripts/plot_lddecay.py"


rule obtain_ceu_ind_id:
    input:
        pcs=f"{folder_pattern}/pca_output/pcs_{vcz_pattern}.txt",
        genetic_df=f"{folder_pattern}/genetic_value_{genetic_value_pattern}.csv",
    output:
        individual_id=f"{folder_pattern}/gwas_output/ceu_ind_id_{vcz_pattern}.txt",
        genetic_value=f"{folder_pattern}/gwas_output/ceu_genetic_value_{genetic_value_pattern}.csv",
    log:
        f"logs/{folder_pattern}/obtain_ceu_ind_id_{vcz_pattern}_{genetic_value_pattern}.log",
    conda:
        "envs/simulation.yaml"
    params:
        individual_seed=lambda wildcards: wildcards.individual_seed,
        arm=lambda wildcards: wildcards.arm,
        chromosome=lambda wildcards: wildcards.chromosome,
        pc1=PC1,
        num_ceu_gwas=NUM_CEU_GWAS,
    script:
        "scripts/obtain_ceu_ind.py"
