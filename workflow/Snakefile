get_thousand_genomes = "resources/1000genomes/1kGP_high_coverage_Illumina.chr{chromosome}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz"


rule obtain_thousand_maf:
    input:
        position_file=ancient(RECOMBINATION_POSITION),
        thousand_genomes=ancient(
            lambda wildcards: get_thousand_genomes.format(
                chromosome=wildcards.chromosome
            )
        ),
    output:
        yri_maf=f"{folder_pattern}/data_process/yri_thousand_maf_{final_ts_pattern}.txt",
        ceu_maf=f"{folder_pattern}/data_process/ceu_thousand_maf_{final_ts_pattern}.txt",
        chb_maf=f"{folder_pattern}/data_process/chb_thousand_maf_{final_ts_pattern}.txt",
        jpt_maf=f"{folder_pattern}/data_process/jpt_thousand_maf_{final_ts_pattern}.txt",
    log:
        f"logs/{folder_pattern}/obtain_thousand_maf_{final_ts_pattern}.log",
    conda:
        "envs/bcftools.yaml"
    resources:
        mem_mb=10000,
    params:
        yri_founder=THOUSAND_YRI_FOUNDER,
        ceu_founder=THOUSAND_CEU_FOUNDER,
        chb_founder=THOUSAND_CHB_FOUNDER,
        jpt_founder=THOUSAND_JPT_FOUNDER,
        arm=lambda wildcards: wildcards.arm,
        chromosome=lambda wildcards: wildcards.chromosome,
    script:
        "scripts/obtain_thousand_maf.py"


